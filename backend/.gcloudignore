# Files NOT uploaded to Cloud Build. Mirrors .dockerignore to keep the upload small.

.gcloudignore
.git/
.gitignore

# Node / Expo frontend
node_modules/
.expo/
ios/
android/
app/
components/
assets/
hooks/
context/
services/
!api/services/
types/
utils/
constants/

# Python venv and cache
api/.venv/
api/__pycache__/
api/**/__pycache__/
api/**/*.pyc

# Secrets
api/.env
api/.env.*
!api/.env.example

# Misc
*.md
.DS_Store
