# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Get from Supabase dashboard → Settings → API → service_role (never expose client-side)
SUPABASE_SERVICE_KEY=<service-role-key>

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret
JWT_EXPIRE_HOURS=24

# CORS — comma-separated list of allowed origins (mobile + web admin)
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081,http://localhost:5173

# Google OAuth — the client id used to verify identity tokens
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# Comma-separated emails auto-promoted to role=admin on sign-in
ADMIN_EMAILS=

# Supabase Storage bucket for STL files + model previews
STORAGE_BUCKET=models

# Rate limiting — uses in-memory by default; set Upstash credentials to share across workers
# Get these from the Upstash console → your database → REST API section
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<your-token>

# App
# development | production
ENV=development
LOG_LEVEL=INFO
