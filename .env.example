# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role key -- server-only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Same project URL + anon/public key, exposed to the browser (safe -- used only for
# customer login via Supabase Auth; all data reads/writes still go through the
# service-role key server-side, never direct anon-key table access).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Single admin password for /admin (no user accounts).
ADMIN_PASSWORD=change-me
# Random long string used to sign the admin session cookie. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# PostHog (Project Settings -> API Keys). Leave blank to disable analytics
# entirely (no PostHog calls, no cookie, no footer link active) -- both
# client and server code check for these before doing anything.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
